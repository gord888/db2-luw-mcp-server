DB2_MCP_MODE=readonly
DB2_MCP_API_KEY=replace-with-your-api-key
DB2_MCP_CONNECTION_STRING=DATABASE=SAMPLE;HOSTNAME=db2.internal;PORT=50000;PROTOCOL=TCPIP;UID=db2_mcp;PWD=change-me;

# Optional overrides
# DB2_MCP_HOST=0.0.0.0
# DB2_MCP_PORT=3000
# DB2_MCP_PUBLIC_BASE_URL=http://db2-mcp.internal:3000
# DB2_MCP_MAX_ROWS=1000
# DB2_MCP_DEFAULT_PREVIEW_ROWS=50
# DB2_MCP_QUERY_TIMEOUT_MS=30000
# DB2_MCP_METADATA_TIMEOUT_MS=15000
# DB2_MCP_REQUEST_BODY_BYTES=1048576
# DB2_MCP_CALLER_LABEL=readonly
# DB2_MCP_DB_LABEL=readonly
# DB2_MCP_DESCRIPTOR_FILES=./config/descriptors.example.yaml
# DB2_MCP_PROCEDURE_ALLOWLIST=SYSPROC.GET_DBSIZE_INFO
